diff -upr a/plugins/obs-browser/CMakeLists.txt b/plugins/obs-browser/CMakeLists.txt
--- obs-studio-32.2.1/plugins/obs-browser/CMakeLists.txt	2026-08-14 03:22:16.833706290 +0200
+++ obs-studio-32.2.1/plugins/obs-browser/CMakeLists.txt	2026-08-14 03:22:16.866721196 +0200
@@ -42,9 +42,21 @@ target_sources(
 
 target_include_directories(obs-browser PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/deps")
 
-target_compile_features(obs-browser PRIVATE cxx_std_17)
+# CEF 128+ headers use C++20 concepts (std::same_as / std::derived_from).
+target_compile_features(obs-browser PRIVATE cxx_std_20)
 target_link_libraries(obs-browser PRIVATE OBS::libobs OBS::frontend-api OBS::websocket-api nlohmann_json::nlohmann_json)
 
+# Prefer the system CEF tree (libcef, Resources, locales) instead of bundling
+# a private copy next to the plugin. CEF_ROOT_DIR is the OnlyOffice/OBS layout
+# root, e.g. /usr/lib64/cef.
+option(OBS_BROWSER_SYSTEM_CEF "Link against system CEF; do not bundle libcef/resources" OFF)
+if(OBS_BROWSER_SYSTEM_CEF)
+  if(NOT CEF_ROOT_DIR)
+    message(FATAL_ERROR "OBS_BROWSER_SYSTEM_CEF requires CEF_ROOT_DIR")
+  endif()
+  target_compile_definitions(obs-browser PRIVATE "OBS_SYSTEM_CEF_ROOT=\"${CEF_ROOT_DIR}\"")
+endif()
+
 if(OS_WINDOWS)
   include(cmake/os-windows.cmake)
 elseif(OS_MACOS)
diff -upr a/plugins/obs-browser/cmake/os-linux.cmake b/plugins/obs-browser/cmake/os-linux.cmake
--- obs-studio-32.2.1/plugins/obs-browser/cmake/os-linux.cmake	2026-08-14 03:22:16.838979109 +0200
+++ obs-studio-32.2.1/plugins/obs-browser/cmake/os-linux.cmake	2026-08-14 03:22:16.866765467 +0200
@@ -5,7 +5,20 @@ get_target_property(libdrm_include_direc
 target_include_directories(obs-browser PRIVATE ${libdrm_include_directories})
 
 target_link_libraries(obs-browser PRIVATE CEF::Wrapper CEF::Library X11::X11)
-set_target_properties(obs-browser PROPERTIES BUILD_RPATH "$ORIGIN/" INSTALL_RPATH "$ORIGIN/")
+
+# System CEF keeps libcef and its dlopen companions (libEGL, swiftshader, …)
+# under ${CEF_ROOT_DIR}/Release. Distro cmake macros often set
+# CMAKE_SKIP_RPATH=ON, so set an absolute rpath explicitly. Keep $ORIGIN so
+# obs-browser-page (the subprocess) is still found next to the plugin.
+if(CEF_ROOT_DIR)
+  set(_obs_cef_libdir "${CEF_ROOT_DIR}/Release")
+else()
+  set(_obs_cef_libdir "$ORIGIN")
+endif()
+set_target_properties(
+  obs-browser
+  PROPERTIES BUILD_RPATH "${_obs_cef_libdir}" INSTALL_RPATH "${_obs_cef_libdir}")
+target_link_options(obs-browser PRIVATE "LINKER:-rpath,${_obs_cef_libdir}")
 
 target_sources(obs-browser PRIVATE drm-format.cpp drm-format.hpp)
 
@@ -20,6 +33,11 @@ target_include_directories(browser-helpe
                                                   "${CMAKE_CURRENT_SOURCE_DIR}/obs-browser-page")
 
 target_link_libraries(browser-helper PRIVATE CEF::Wrapper CEF::Library)
+target_compile_features(browser-helper PRIVATE cxx_std_20)
+if(OBS_BROWSER_SYSTEM_CEF)
+  target_compile_definitions(browser-helper PRIVATE "OBS_SYSTEM_CEF_ROOT=\"${CEF_ROOT_DIR}\"")
+endif()
+target_link_options(browser-helper PRIVATE "LINKER:-rpath,${_obs_cef_libdir}")
 
 target_sources(obs-browser PRIVATE deps/ip-string-posix.cpp)
 
@@ -29,8 +47,8 @@ set(OBS_EXECUTABLE_DESTINATION "${OBS_PL
 set_target_properties_obs(
   browser-helper
   PROPERTIES FOLDER plugins/obs-browser
-             BUILD_RPATH "$ORIGIN/"
-             INSTALL_RPATH "$ORIGIN/"
+             BUILD_RPATH "${_obs_cef_libdir}"
+             INSTALL_RPATH "${_obs_cef_libdir}"
              PREFIX ""
              OUTPUT_NAME obs-browser-page)
 # cmake-format: on
diff -upr a/plugins/obs-browser/obs-browser-plugin.cpp b/plugins/obs-browser/obs-browser-plugin.cpp
--- obs-studio-32.2.1/plugins/obs-browser/obs-browser-plugin.cpp	2026-08-14 03:22:16.844181747 +0200
+++ obs-studio-32.2.1/plugins/obs-browser/obs-browser-plugin.cpp	2026-08-14 03:27:13.451303997 +0200
@@ -316,6 +316,12 @@ static void BrowserInit(void)
 #endif
 
 #if !defined(_WIN32) && !defined(__APPLE__)
+#ifdef OBS_SYSTEM_CEF_ROOT
+	/* Distro CEF keeps Resources/ next to Release/ (OnlyOffice/OBS layout).
+	 * Do not expect a private copy of paks/locales beside the plugin. */
+	CefString(&settings.resources_dir_path) = OBS_SYSTEM_CEF_ROOT "/Resources";
+	CefString(&settings.locales_dir_path) = OBS_SYSTEM_CEF_ROOT "/Resources/locales";
+#else
 	// Override locale path from OBS binary path to plugin binary path
 	string locales = obs_get_module_binary_path(obs_current_module());
 	locales = locales.substr(0, locales.find_last_of('/') + 1);
@@ -323,6 +329,7 @@ static void BrowserInit(void)
 	BPtr<char> abs_locales = os_get_abs_path_ptr(locales.c_str());
 	CefString(&settings.locales_dir_path) = abs_locales;
 #endif
+#endif
 
 	std::string obs_locale = obs_get_locale();
 	std::string accepted_languages;
@@ -367,6 +374,14 @@ static void BrowserInit(void)
 	app = new BrowserApp(tex_sharing_avail, obs_get_nix_platform() == OBS_NIX_PLATFORM_WAYLAND);
 #endif
 
+#if !defined(_WIN32) && !defined(__APPLE__) && defined(ENABLE_WAYLAND)
+	/* libcef dlopens GTK3 and gtk_init_check() opens a second Wayland
+	 * connection beside Qt's. That corrupts libwayland-client
+	 * (realloc(): invalid next size) when adding a Browser source. */
+	if (obs_get_nix_platform() == OBS_NIX_PLATFORM_WAYLAND)
+		setenv("GDK_BACKEND", "x11", 0);
+#endif
+
 #ifdef _WIN32
 	CefExecuteProcess(args, app, nullptr);
 #endif
@@ -751,6 +766,18 @@ bool obs_module_load(void)
 	if (hwaccel) {
 		check_hwaccel_support();
 	}
+#ifdef OBS_SYSTEM_CEF_ROOT
+#ifdef ENABLE_WAYLAND
+	/* System CEF uses ANGLE (and often Vulkan). OBS composites with Mesa
+	 * EGL; eglCreateImageKHR on those dmabufs fails ("Cannot create
+	 * EGLImage") and OnPaint is skipped → black Browser source. */
+	if (hwaccel && obs_get_nix_platform() == OBS_NIX_PLATFORM_WAYLAND) {
+		hwaccel = false;
+		blog(LOG_INFO, "[obs-browser]: disabling GPU texture sharing "
+			       "with system CEF on Wayland (EGLImage import)");
+	}
+#endif
+#endif
 #endif
 
 	return true;
