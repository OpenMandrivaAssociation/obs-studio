-set_target_properties(obs-browser PROPERTIES BUILD_RPATH "$ORIGIN/" INSTALL_RPATH "$ORIGIN/")
+
+# System CEF keeps libcef and its dlopen companions (libEGL, swiftshader, …)
+# under ${CEF_ROOT_DIR}/Release. Distro cmake macros often set
+# CMAKE_SKIP_RPATH=ON, so set an absolute rpath explicitly.
+if(CEF_ROOT_DIR)
+  set(_obs_cef_libdir "${CEF_ROOT_DIR}/Release")
+else()
+  set(_obs_cef_libdir "$ORIGIN")
+endif()
+set_target_properties(
+  obs-browser
+  PROPERTIES BUILD_RPATH "${_obs_cef_libdir}" INSTALL_RPATH "${_obs_cef_libdir}")
+target_link_options(obs-browser PRIVATE "LINKER:-rpath,${_obs_cef_libdir}")
 
