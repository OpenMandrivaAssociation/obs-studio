+# Prefer the system CEF tree (libcef, Resources, locales) instead of bundling
+# a private copy next to the plugin. CEF_ROOT_DIR is the distro CEF root,
+# e.g. /usr/lib64/cef.
+option(OBS_BROWSER_SYSTEM_CEF "Link against system CEF; do not bundle libcef/resources" OFF)
+if(OBS_BROWSER_SYSTEM_CEF)
+  if(NOT CEF_ROOT_DIR)
+    message(FATAL_ERROR "OBS_BROWSER_SYSTEM_CEF requires CEF_ROOT_DIR")
+  endif()
+  target_compile_definitions(obs-browser PRIVATE "OBS_SYSTEM_CEF_ROOT=\"${CEF_ROOT_DIR}\"")
+endif()
+
